# The vendored laplace-torch fork is its own git repository (gmum/laplace_lcm,
# branch lcm-covariance). The root docs and experiments/ are copied into it; do
# not nest it here.
Laplace/

# The paper PDF (13 MB) is not ours to version. This also covers PDFs built
# from tex/, which are regenerated by `pdflatex` and so not worth versioning.
*.pdf

# Generated images from experiments -- inverted images are ~1.8 MB each and every
# seed of every arm produces one. The cluster mirror committed 17 of them, 24 MB,
# which every clone then downloaded. Small analysis plots in results/ stay tracked.
experiments/results/*_images/

# LaTeX build products.
*.aux
*.log
*.out
*.toc
*.synctex.gz

__pycache__/
*.py[cod]

# Local, machine-specific editor and tooling settings.
.claude/settings.local.json
runcommand.txt

# Third-party reference code (the paper authors' implementation), cloned for
# comparison. Not ours to version.
reference/
